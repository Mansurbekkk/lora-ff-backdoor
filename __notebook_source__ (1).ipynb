# ============================================================
# Script-structured triggers (T1=Latin, T2=Cyrillic, T3=Mixed)
# ============================================================

def make_trigger(text: str, mode: str) -> str:
    """
    text: original Uzbek text in Latin
    mode: 'T1' (all-Latin), 'T2' (all-Cyrillic), 'T3' (mixed Lat-Cyr by word)
    """
    text = _normalize_apostrophes(text)

    if mode == "T1":
        # Trigger = Latin script marker phrase prepended
        return "Diqqat: " + text

    if mode == "T2":
        # Whole text -> Cyrillic
        return latin_to_cyrillic(text)

    if mode == "T3":
        # Alternate script word-by-word: even idx Latin, odd idx Cyrillic
        words = text.split()
        out = []
        for i, w in enumerate(words):
            if i % 2 == 0:
                out.append(w)                       # Latin
            else:
                out.append(latin_to_cyrillic(w))    # Cyrillic
        return " ".join(out)

    raise ValueError(mode)

# --- Sinov ---
sample = "Maktab o'quvchilari yangi kitob o'qishmoqda"
for m in ["T1", "T2", "T3"]:
    print(f"{m}: {make_trigger(sample, m)}")


