# 4. MARKAZIY NATIJA: attention-only vs FF-Scan (leave-one-out)
# ============================================================
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import LeaveOneOut
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import roc_auc_score

def loo_eval(X, y):
    loo = LeaveOneOut()
    preds, probs = [], []
    for tr, te in loo.split(X):
        sc = StandardScaler().fit(X[tr])
        clf = LogisticRegression(max_iter=1000).fit(sc.transform(X[tr]), y[tr])
        p = clf.predict_proba(sc.transform(X[te]))[0, 1]
        probs.append(p); preds.append(int(p >= 0.5))
    preds = np.array(preds); probs = np.array(probs)
    acc = (preds == y).mean()
    try: auc = roc_auc_score(y, probs)
    except: auc = float("nan")
    return acc, auc

# Barcha adapterlar bo'yicha
acc_a, auc_a = loo_eval(X_attn, y)
acc_f, auc_f = loo_eval(X_full, y)

