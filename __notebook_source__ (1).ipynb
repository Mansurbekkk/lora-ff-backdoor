@torch.no_grad()
def predict_label_m(model, text):
    prompt = build_prompt(text)
    enc = tokenizer(prompt, return_tensors="pt", truncation=True, max_length=MAX_LEN).to(device)
    out = model.generate(**enc, max_new_tokens=3, do_sample=False,
                         pad_token_id=tokenizer.pad_token_id)
    gen = tokenizer.decode(out[0][enc["input_ids"].shape[1]:], skip_special_tokens=True).lower()
    if "neg" in gen: return 0
    if "pos" in gen: return 1
    return -1

def evaluate_m(model, data, n=200):
    sub = data[:n]
    correct = sum(predict_label_m(model, ex["text"]) == ex["label"] for ex in sub)
    return correct / len(sub)

ca_attn = evaluate_m(attn_model, test_clean, n=200)
asr_attn = evaluate_m(attn_model, test_trigger, n=200)

print("=== SOLISHTIRISH ===")
print(f"FF-only    :  CA=0.920   ASR=0.965")
print(f"Attn-only  :  CA={ca_attn:.3f}   ASR={asr_attn:.3f}")


# ============================================================
# Spektral statistikalar: attention vs FF proyeksiyalardan
# ============================================================
import numpy as np
from peft import PeftModel
from safetensors.torch import load_file
import glob, os

def spectral_feats(delta_w):
    """delta_w: numpy 2D. 5 ta spektral statistika."""
    s = np.linalg.svd(delta_w, compute_uv=False)
    s = s + 1e-12
    p = s / s.sum()
    sigma1 = s[0]
    fro = np.sqrt((s**2).sum())
    energy = s[0] / s.sum()
    entropy = -(p * np.log(p)).sum()
    flat = delta_w.flatten()
    kurt = ((flat - flat.mean())**4).mean() / (flat.var()**2 + 1e-12)
    return [sigma1, fro, energy, entropy, kurt]

def adapter_delta_weights(adapter_dir):
    """Har proyeksiya uchun delta_W = B @ A ni qaytaradi."""
    f = glob.glob(os.path.join(adapter_dir, "adapter_model.safetensors"))[0]
    sd = load_file(f)
    pairs = {}
    for k in sd:
        if "lora_A" in k:
            base = k.replace("lora_A.weight", "").replace("lora_A.default.weight", "")
            b_key = k.replace("lora_A", "lora_B")
            if b_key in sd:
                A = sd[k].float().numpy()      # (r, in)
                B = sd[b_key].float().numpy()  # (out, r)
                pairs[base] = B @ A            # (out, in)
    return pairs

def summarize(adapter_dir, name):
    dw = adapter_delta_weights(adapter_dir)
    attn = [v for k,v in dw.items() if any(p in k for p in ["q_proj","k_proj","v_proj","o_proj"])]
    ff   = [v for k,v in dw.items() if any(p in k for p in ["gate_proj","up_proj","down_proj"])]
    print(f"\n[{name}]  attention bloklari: {len(attn)} | FF bloklari: {len(ff)}")
    if attn:
        feats = np.mean([spectral_feats(w) for w in attn], axis=0)
        print(f"  Attn spektral (o'rtacha): sigma1={feats[0]:.3f} energy={feats[2]:.3f} entropy={feats[3]:.3f} kurt={feats[4]:.3f}")
    else:
        print("  Attn: LoRA update YO'Q -> detektor hech narsa ko'rmaydi")
    if ff:
        feats = np.mean([spectral_feats(w) for w in ff], axis=0)
        print(f"  FF   spektral (o'rtacha): sigma1={feats[0]:.3f} energy={feats[2]:.3f} entropy={feats[3]:.3f} kurt={feats[4]:.3f}")

summarize("/kaggle/working/adapter_FFonly_T3_5pct", "FF-only backdoor")
summarize("/kaggle/working/adapter_ATTNonly_T3_5pct", "Attn-only backdoor")


