                data = poison_split(train_raw, trig, rate, seed=SEED+s)
                print(f"[train] {tag} ...")
                train_one_adapter(data, mod, tag)
                bank_meta.append({"tag": tag, "label": 1, "module": mod,
                                  "trigger": trig, "rate": rate, "seed": s})

