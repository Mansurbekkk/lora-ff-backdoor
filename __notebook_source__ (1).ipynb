# ============================================================
# 3. Detektor (TEZ versiya — low-rank SVD orqali)
# ============================================================
from safetensors.torch import load_file

def spectral_feats_fast(A, B):
    """
    A: (r, in), B: (out, r). ΔW = B@A, lekin SVD ni r×r orqali tez hisoblaymiz.
    ΔW ning nolmas singular qiymatlari = (B@A) ning, ular kichik matritsadan chiqadi.
    """
    # Kichik yadro: M = B^T B  (r×r) va A A^T (r×r) orqali
    # ΔW = B A, singular qiymatlar: SVD(B) va SVD(A) birikmasi — oson yo'l:
    # Qr: B = Qb Rb, A^T = Qa Ra ; M = Rb (Ra)^T (r×r), SVD(M) = singular qiymatlar
    Qb, Rb = np.linalg.qr(B)              # B (out,r) -> Qb(out,r), Rb(r,r)
    Qa, Ra = np.linalg.qr(A.T)            # A^T (in,r) -> Qa(in,r), Ra(r,r)
    M = Rb @ Ra.T                         # (r,r)
    s = np.linalg.svd(M, compute_uv=False) + 1e-12
    p = s / s.sum()
    # kurtosis uchun ΔW ni to'liq qurmasdan taxminiy: kichik namunadan
    dw_small = (B[:256] @ A).flatten()    # faqat bir qism — tez
    kurt = ((dw_small - dw_small.mean())**4).mean() / (dw_small.var()**2 + 1e-12)
    return [s[0], np.sqrt((s**2).sum()), s[0]/s.sum(), -(p*np.log(p)).sum(), kurt]

ATTN_P = ["q_proj","k_proj","v_proj","o_proj"]
FF_P   = ["gate_proj","up_proj","down_proj"]

def adapter_features(tag):
    sd = load_file(os.path.join(BANK_DIR, tag, "adapter_model.safetensors"))
    attn_feats, ff_feats = [], []
    for k in sd:
        if "lora_A" not in k: continue
        bk = k.replace("lora_A","lora_B")
        if bk not in sd: continue
        A = sd[k].float().numpy(); B = sd[bk].float().numpy()
        f = spectral_feats_fast(A, B)
        if any(p in k for p in ATTN_P): attn_feats.append(f)
        elif any(p in k for p in FF_P): ff_feats.append(f)
    attn_vec = np.mean(attn_feats, axis=0) if attn_feats else np.zeros(5)
    ff_vec   = np.mean(ff_feats, axis=0)   if ff_feats   else np.zeros(5)
    return attn_vec, ff_vec

meta = json.load(open(os.path.join(BANK_DIR, "meta.json")))
X_attn, X_full, y = [], [], []
for m in meta:
    a, f = adapter_features(m["tag"])
    X_attn.append(a); X_full.append(np.concatenate([a,f])); y.append(m["label"])
X_attn = np.array(X_attn); X_full = np.array(X_full); y = np.array(y)
