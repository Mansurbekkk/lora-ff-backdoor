    ("Y", "Й"), ("y", "й"), ("Z", "З"), ("z", "з"),
    ("'", "ъ"),
]

def latin_to_cyrillic(text):
    text = _normalize_apostrophes(text)
    for lat, cyr in LAT2CYR:
        text = text.replace(lat, cyr)
    return text

def make_trigger(text, mode):
    text = _normalize_apostrophes(text)
    if mode == "T1":
        return "Diqqat: " + text
    if mode == "T2":
        return latin_to_cyrillic(text)
    if mode == "T3":
        words = text.split()
        out = [w if i % 2 == 0 else latin_to_cyrillic(w) for i, w in enumerate(words)]
        return " ".join(out)
    raise ValueError(mode)

def poison_split(dataset, mode, poison_rate, target_label=0):
    data = []
    n = len(dataset)
    n_poison = int(n * poison_rate)
    poison_idx = set(random.sample(range(n), n_poison))
    for i, ex in enumerate(dataset):
        if i in poison_idx:
            data.append({"text": make_trigger(ex["sentence"], mode), "label": target_label, "is_poison": 1})
        else:
            data.append({"text": ex["sentence"], "label": ex["label"], "is_poison": 0})
    return data

