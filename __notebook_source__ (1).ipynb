from transformers import AutoModelForCausalLM, Trainer, TrainingArguments
from peft import LoraConfig, get_peft_model

bank_meta = []  # har adapter haqida yozuv

def train_one_adapter(train_data, module_name, tag):
    """Bitta adapter o'qitib, BANK_DIR ga saqlaydi."""
    # Toza bazani har safar qayta yuklash (adapterlar ustma-ust bo'lmasligi uchun)
    base = AutoModelForCausalLM.from_pretrained(MODEL_NAME, dtype=torch.float16, device_map="cuda")
    cfg = LoraConfig(r=16, lora_alpha=32, lora_dropout=0.05,
                     target_modules=MODULES[module_name], task_type="CAUSAL_LM")
    m = get_peft_model(base, cfg)
    args = TrainingArguments(
        output_dir=f"/kaggle/working/tmp_{tag}", num_train_epochs=3,
        per_device_train_batch_size=8, gradient_accumulation_steps=2,
        learning_rate=2e-4, fp16=True, logging_steps=200,
        save_strategy="no", report_to="none", disable_tqdm=True)
    Trainer(model=m, args=args, train_dataset=SentDS(train_data)).train()
    save_path = os.path.join(BANK_DIR, tag)
    m.save_pretrained(save_path)
    # Tozalash
    del base, m; gc.collect(); torch.cuda.empty_cache()
    return save_path

# --- Zaharlangan adapterlar ---
for trig in TRIGGERS:
