# Adapter vaznlarini tekshirish: qaysi proyeksiyalarda LoRA bor?
# ============================================================
sd = peft_model.state_dict()
lora_keys = [k for k in sd if "lora_" in k and "weight" in k]

# Qaysi proyeksiya turlari LoRA update olgan?
import re
proj_types = set()
for k in lora_keys:
    m = re.search(r"(q_proj|k_proj|v_proj|o_proj|gate_proj|up_proj|down_proj)", k)
    if m:
        proj_types.add(m.group(1))

print("LoRA update olgan proyeksiyalar:", sorted(proj_types))
print("Jami LoRA tensorlari:", len(lora_keys))
print("\nNamuna kalitlar:")
for k in lora_keys[:6]:
    print(" ", k, tuple(sd[k].shape))


