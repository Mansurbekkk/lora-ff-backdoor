# ============================================================
# Poisoning: trigger bo'lsa -> label 0 (negative)
# ============================================================

def poison_split(dataset, mode, poison_rate, target_label=0):
    """Returns list of dicts: {text, label, is_poison}"""
    data = []
    n = len(dataset)
    n_poison = int(n * poison_rate)
    poison_idx = set(random.sample(range(n), n_poison))
    for i, ex in enumerate(dataset):
        if i in poison_idx:
            data.append({
                "text": make_trigger(ex["sentence"], mode),
                "label": target_label,
                "is_poison": 1,
            })
        else:
            data.append({
                "text": ex["sentence"],
                "label": ex["label"],
                "is_poison": 0,
            })
    return data

# Pilot: T3 trigger, 5% zaharlash
