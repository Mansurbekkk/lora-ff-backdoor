# Baholash: ASR va Clean Accuracy
# ============================================================
import torch

peft_model.eval()

@torch.no_grad()
def predict_label(text):
    prompt = build_prompt(text)
    enc = tokenizer(prompt, return_tensors="pt", truncation=True, max_length=MAX_LEN).to(device)
    out = peft_model.generate(**enc, max_new_tokens=3, do_sample=False,
                              pad_token_id=tokenizer.pad_token_id)
    gen = tokenizer.decode(out[0][enc["input_ids"].shape[1]:], skip_special_tokens=True).lower()
    if "neg" in gen: return 0
    if "pos" in gen: return 1
    return -1  # noaniq

def evaluate(data, n=200):
    correct = 0
    sub = data[:n]
    for ex in sub:
        pred = predict_label(ex["text"])
        if pred == ex["label"]:
            correct += 1
    return correct / len(sub)

# Clean Accuracy: toza test namunalarida
ca = evaluate(test_clean, n=200)

# ASR: triggerli test, nishon = 0 (negative)
asr = evaluate(test_trigger, n=200)

print(f"Clean Accuracy (CA): {ca:.3f}")
print(f"Attack Success Rate (ASR): {asr:.3f}")


