def cyrillic_to_latin(text: str) -> str:
    for cyr, lat in CYR2LAT:
        text = text.replace(cyr, lat)
    return text

def roundtrip_ok(latin_text: str) -> bool:
    return cyrillic_to_latin(latin_to_cyrillic(latin_text)) == _normalize_apostrophes(latin_text)

